# Local MySQL (use the password set when creating the database user).
DATABASE_URL=mysql://logicraft:local-db-password@127.0.0.1:3306/logicraft
DJANGO_SECRET_KEY=replace-with-a-local-secret
DEBUG=true
ENABLE_LOCAL_AUTH=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional existing Supabase authentication; not needed for local login.
# Set ENABLE_LOCAL_AUTH=false when using this option.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_AUDIENCE=authenticated
# Put these frontend settings in frontend/.env.local only if using Supabase:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
